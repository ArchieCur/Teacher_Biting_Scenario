{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene.schema.json",
  "title": "Scene content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "nodes"],
  "properties": {
    "id": { "$ref": "#/definitions/id" },
    "title": { "type": "string", "minLength": 1 },
    "clock": { "type": "string" },
    "place": { "type": "string" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "when": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "boolean" }
    },
    "text": {
      "description": "Plain text, or a list of variants. Variants are tried in order; the last one must have no 'when'.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": { "when": { "$ref": "#/definitions/when" }, "text": { "type": "string" } }
          }
        }
      ]
    },
    "next": {
      "oneOf": [
        { "$ref": "#/definitions/id" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to"],
            "properties": { "when": { "$ref": "#/definitions/when" }, "to": { "$ref": "#/definitions/id" } }
          }
        }
      ]
    },
    "fillValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "when": { "$ref": "#/definitions/when" },
              "value": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
            }
          }
        }
      ]
    },
    "monday": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "title": { "$ref": "#/definitions/text" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["do"],
            "properties": { "do": { "$ref": "#/definitions/text" }, "say": { "$ref": "#/definitions/text" } }
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "tone", "consequence", "why", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/text" },
        "tone": { "enum": ["held", "partial", "risk"] },
        "outcomeLabel": { "$ref": "#/definitions/text" },
        "consequence": { "$ref": "#/definitions/text" },
        "why": { "$ref": "#/definitions/text" },
        "say": { "$ref": "#/definitions/text" },
        "showIf": { "$ref": "#/definitions/when" },
        "setFlags": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "fill": { "type": "object", "additionalProperties": { "$ref": "#/definitions/fillValue" } },
        "next": { "$ref": "#/definitions/next" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "heading"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "enum": ["story", "dialogue", "form", "debrief", "wrap"] },
        "heading": { "$ref": "#/definitions/text" },
        "body": { "$ref": "#/definitions/text" },
        "summary": { "type": "string", "description": "Short decision name for 'Your day at a glance'." },
        "prompt": { "$ref": "#/definitions/text" },
        "speaker": { "type": "string" },
        "line": { "$ref": "#/definitions/text" },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": { "type": "array", "items": { "type": "string" } },
            "later": { "type": "array", "items": { "type": "string" } },
            "laterNote": { "type": "string" }
          }
        },
        "monday": { "$ref": "#/definitions/monday" },
        "choices": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/choice" } },
        "next": { "$ref": "#/definitions/next" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "dialogue" } } },
          "then": { "required": ["speaker", "line"] }
        },
        {
          "if": { "properties": { "type": { "const": "form" } } },
          "then": { "required": ["sections"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["debrief", "wrap"] } } },
          "then": { "not": { "required": ["choices"] } }
        },
        {
          "if": { "required": ["choices"] },
          "then": { "required": ["summary", "prompt"], "not": { "required": ["next"] } }
        }
      ],
      "additionalProperties": false
    }
  }
}
