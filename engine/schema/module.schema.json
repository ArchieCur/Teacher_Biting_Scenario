{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module.schema.json",
  "title": "Module file (module.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "lang", "start", "scenes", "characters", "flags", "disclosure", "storyline"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "lang": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "start": { "type": "string" },
    "scenes": {
      "description": "Scene file names in scenes/, without .yaml, in playing order.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "disclosure": { "type": "string", "minLength": 1 },
    "characters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["children", "adults"],
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["initials"],
            "properties": {
              "initials": { "type": "string", "pattern": "^([A-Z]\\.){2,3}$" },
              "pronouns": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "adults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "pronouns": { "type": "string" }
            }
          }
        }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["default", "description"],
        "properties": {
          "default": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "storyline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable"],
      "properties": {
        "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "targetOrigin": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "buttonLabel": { "type": "string" }
      }
    },
    "documents": {
      "description": "Source documents that nodes can show as a paper card (node field 'document').",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "title"],
        "properties": {
          "file": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source", "sections"],
      "properties": {
        "title": { "type": "string" },
        "source": { "type": "string", "description": "Source form file; section titles and field labels are checked against it." },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "fields"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "kind"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                    "label": { "type": "string" },
                    "group": { "type": "string", "description": "Sub-heading shared by consecutive fields, as printed on the source form." },
                    "kind": { "enum": ["text", "choice", "checks"] },
                    "options": { "type": "array", "items": { "type": "string" } }
                  },
                  "if": { "properties": { "kind": { "enum": ["choice", "checks"] } } },
                  "then": { "required": ["options"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
